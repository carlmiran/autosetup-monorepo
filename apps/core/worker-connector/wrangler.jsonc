{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "autosetup-worker-connector",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"], // necessário para o parser xlsx
  // Explícitos pra bater com o painel e o `wrangler deploy` não avisar
  // diferença. preview_urls = false: cada versão antiga ganha uma URL própria
  // (<versão>-<worker>.<conta>.workers.dev) que continua servindo o código
  // ANTIGO — no web isso expunha /api/admin/clientes sem senha (versões de
  // antes do Basic Auth). Desligado no painel do web em 24/10/2026 com
  // autorização do Carlos.
  // Neste Worker ainda está ligado no painel — vale no próximo deploy.
  "workers_dev": true,
  "preview_urls": false,
  // Workers Logs: guarda os logs do Worker (inclusive as linhas "[seguranca]"
  // de src/lib/eventoSeguranca.ts no web) — sem isso eles só aparecem ao vivo
  // no `wrangler tail`. Pacote 1 (24/10/2026). No painel estava desligado.
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "autosetup-leads",
      "database_id": "6020ad64-35e8-4e90-a0b1-46020eb4b53b"
    }
  ],
  "r2_buckets": [
    {
      "binding": "CONNECTOR_UPLOADS",
      "bucket_name": "autosetup-connector-uploads"
    }
  ],
  "queues": {
    "producers": [
      { "binding": "SYNC_QUEUE", "queue": "connector-sync-queue" }
    ],
    "consumers": [
      { "queue": "connector-sync-queue", "max_batch_size": 10, "max_retries": 5 }
    ]
  },
  "vars": {
    // "autosetup.digital" não está verificado na conta Resend (confirmado
    // via teste real: API recusa com HTTP 403 "domain is not verified").
    // Usando o domínio de teste da própria Resend, que não exige
    // verificação — mesmo padrão já usado em outro lugar do projeto
    // (notificação de pagamento). Trocar de volta pra
    // "connector@autosetup.digital" se/quando o domínio for verificado
    // em https://resend.com/domains.
    "ALERT_EMAIL_FROM": "onboarding@resend.dev"
  }
  // RESEND_API_KEY -> `wrangler secret put RESEND_API_KEY`
  // ALERT_EMAIL_TO -> `wrangler secret put ALERT_EMAIL_TO` (e-mail não é
  //   secreto por natureza, mas cadastrado como secret aqui pra evitar
  //   mais um valor real commitado neste arquivo — ver
  //   docs/secrets-registry.md)
  // LENS_REFRESH_URL -> opcional, endpoint interno de regeneração do
  //   diagnóstico LENS. Sem efeito se não configurado.
}

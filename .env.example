# AUTOSETUP — .env.example
# Copie para .env e preencha. NUNCA commitar o .env real.

# Banco de dados (Postgres local via docker/docker-compose.dev.yml)
DATABASE_URL="postgresql://autosetup:autosetup_dev_only@localhost:5432/autosetup_dev"

# Auth (Auth.js / Clerk / Supabase Auth — decisão IMP em aberto)
AUTH_SECRET=

# WhatsApp de contato exibido no botão de fechamento do diagnóstico
# (não é secret — fica público no link do botão de qualquer forma)
NEXT_PUBLIC_WHATSAPP_NUMERO=

# LLM Gateway (IMP-LLM-001) — configure PELO MENOS UMA chave.
# O Gateway tenta na ordem abaixo e cai para a próxima automaticamente
# se uma falhar (rate limit, indisponibilidade, etc). Ordem customizável
# via AUTOSETUP_LLM_PRIORITY (ex: "anthropic,openai,groq").
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=
CEREBRAS_API_KEY=
AUTOSETUP_LLM_PRIORITY=

# Storage S3-compatível
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=

# Supabase (se usado como Auth/Storage — decisão IMP em aberto junto com AUTH_SECRET)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Event Bus (Postgres Queue para MVP — ver ADR de stack)
EVENT_BUS_DRIVER=postgres

# NOTA — o que NÃO entra aqui:
# GITHUB_TOKEN (ou qualquer PAT de escrita em repositório) não é um
# secret de runtime da aplicação — é uma credencial de ferramenta de
# dev/CI. Ela vive em GitHub Actions Secrets (se um workflow precisar) ou
# no seu gerenciador de credenciais local (git credential manager / gh
# auth login), nunca junto dos secrets que o app lê em produção.
# Ver docs/secrets-registry.md para onde cada chave acima deve ser
# efetivamente armazenada (local vs. Cloudflare Pages vs. Supabase).

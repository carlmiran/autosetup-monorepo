# AUTOSETUP — .env.example
# Copie para .env e preencha. NUNCA commitar o .env real.

# Banco de dados (Postgres local via docker/docker-compose.dev.yml)
DATABASE_URL="postgresql://autosetup:autosetup_dev_only@localhost:5432/autosetup_dev"

# Auth (Auth.js / Clerk / Supabase Auth — decisão IMP em aberto)
AUTH_SECRET=

# Camada de abstração de LLM (IMP-LLM-001) — OpenAI inicialmente,
# nunca acoplado a um único provider
LLM_PROVIDER=openai
OPENAI_API_KEY=

# Storage S3-compatível
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=

# Event Bus (Postgres Queue para MVP — ver ADR de stack)
EVENT_BUS_DRIVER=postgres
